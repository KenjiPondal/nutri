{
  "name": "nutri",
  "version": "0.1.0-alpha",
  "description": "Nutri: nutrition coaching with Whoop",
  "private": true,
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "build": "npm run build --workspace=client",
    "start": "npm start --workspace=server",
    "seed": "npm run seed --workspace=server",
    "tunnel": "cloudflared tunnel --no-autoupdate --url http://localhost:5173",
    "migrate": "npm run migrate --workspace=server"
  },
  "engines": {
    "node": ">=20"
  }
}
