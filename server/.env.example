PORT=5000
MONGODB_URI=mongodb://localhost:27017/fullcoach
JWT_SECRET=your_jwt_secret_here
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
CLIENT_URL=http://localhost:5173

# --- Whoop (https://developer-dashboard.whoop.com) ---
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
# Must exactly match a Redirect URI registered on your Whoop app
WHOOP_REDIRECT_URI=http://localhost:5000/api/whoop/callback
# Background re-sync interval (minutes)
WHOOP_SYNC_MINUTES=30
# 64 hex chars; encrypts Whoop tokens at rest. Generate: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=
